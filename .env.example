# Copia este archivo como .env para cambiar la configuración sin editar configs/config.yaml.
# .env no se sube a Git. Todas las variables son opcionales.

# Otro archivo de configuración (ruta relativa a la raíz del repositorio)
# LECTOR_CONFIG=configs/config.yaml

# Nivel de registro: DEBUG, INFO, WARNING o ERROR
# LECTOR_NIVEL_LOG=INFO

# Carpeta donde se descargan y verifican los pesos de Tesseract
# LECTOR_PESOS=models

# Carpeta de salidas locales
# LECTOR_SALIDAS=outputs
